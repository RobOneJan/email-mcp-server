# Which EmailProvider implementation to wire up. One of: fake | gmail
# "fake" needs no credentials and is the default for local dev/tests.
EMAIL_PROVIDER=gmail

# --- Gmail (required only when EMAIL_PROVIDER=gmail) ---
# Create an OAuth 2.0 Desktop client in Google Cloud Console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8765/oauth2/callback

# Where the OAuth token (obtained via scripts/gmail_auth.py) is persisted.
# Swap this out for a Secret Manager/Vault-backed TokenStore in production;
# see src/email_mcp/ports/token_store.py.
OAUTH_TOKEN_STORAGE=./var/gmail_token.json

# --- Approval store ---
# Where pending/approved/rejected human approval requests are persisted.
# scripts/approve_request.py reads/writes the same file, out-of-band from the MCP server.
APPROVAL_STORE_PATH=./var/approvals.json

# How long a send approval stays valid before it expires (minutes).
APPROVAL_TTL_MINUTES=30

# --- Logging ---
# One of: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# One of: text (human-readable, for local dev) | json (one JSON object per
# line, auto-parsed as structured logs by Cloud Logging - use this on Cloud Run).
LOG_FORMAT=text

# Where audit log entries (write-actions only, no content/secrets) are appended.
AUDIT_LOG_PATH=./var/audit.log

# --- Transport ---
# One of: stdio (local MCP clients, e.g. Claude Desktop) | streamable-http
# (hosted deployments, e.g. Cloud Run - required since Cloud Run only routes HTTP).
MCP_TRANSPORT=stdio

# Port to listen on when MCP_TRANSPORT=streamable-http. Cloud Run injects $PORT
# itself at runtime; this default only matters for local HTTP testing.
PORT=8080
