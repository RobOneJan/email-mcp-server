# Which EmailProvider implementation to wire up. One of: fake | gmail | imap
# "fake" needs no credentials and is the default for local dev/tests.
EMAIL_PROVIDER=gmail

# --- Gmail (required only when EMAIL_PROVIDER=gmail) ---
# Create an OAuth 2.0 Desktop client in Google Cloud Console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8765/oauth2/callback

# Directory where per-tenant OAuth tokens (obtained via scripts/gmail_auth.py
# --tenant <id>) are persisted, one file per tenant: <dir>/<tenant_id>.json.
# Swap this out for a Secret Manager/Vault-backed TokenStore in production;
# see src/email_mcp/ports/token_store.py.
OAUTH_TOKEN_STORAGE=./var/tokens

# --- IMAP/SMTP (required only when EMAIL_PROVIDER=imap) ---
# Plain username/password over TLS - what the overwhelming majority of
# non-Gmail/non-Graph mail hosts require (use an app-specific password where
# the host mandates one, e.g. most consumer webmail hosts with 2FA).
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
# true for implicit-TLS SMTP (typically port 465); false = STARTTLS (587, the common default)
SMTP_USE_SSL=false

# Folder names are not standardized across IMAP hosts (INBOX.Drafts vs
# [Gmail]/Drafts vs Drafts, Sent vs "Sent Items", ...) - check your host's
# folder names and override here if they differ from these common defaults.
IMAP_INBOX_FOLDER=INBOX
IMAP_DRAFTS_FOLDER=Drafts
IMAP_SENT_FOLDER=Sent

# From: header / SMTP envelope sender for outgoing mail. Defaults to
# IMAP_USERNAME if unset - correct for the common case of one mailbox = one
# login = one send-as address.
IMAP_FROM_ADDRESS=

# --- Approval store ---
# Where pending/approved/rejected human approval requests are persisted.
# scripts/approve_request.py reads/writes the same file, out-of-band from the MCP server.
APPROVAL_STORE_PATH=./var/approvals.json

# How long a send approval stays valid before it expires (minutes).
APPROVAL_TTL_MINUTES=30

# --- Logging ---
# One of: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# One of: text (human-readable, for local dev) | json (one JSON object per
# line, auto-parsed as structured logs by Cloud Logging - use this on Cloud Run).
LOG_FORMAT=text

# Where audit log entries (write-actions only, no content/secrets) are appended.
AUDIT_LOG_PATH=./var/audit.log

# --- Transport ---
# One of: stdio (local MCP clients, e.g. Claude Desktop) | streamable-http
# (hosted deployments, e.g. Cloud Run - required since Cloud Run only routes HTTP).
MCP_TRANSPORT=stdio

# Port to listen on when MCP_TRANSPORT=streamable-http. Cloud Run injects $PORT
# itself at runtime; this default only matters for local HTTP testing.
PORT=8080
